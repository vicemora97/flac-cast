{
  "name": "flac-cast",
  "productName": "Flac Cast",
  "version": "0.1.2",
  "private": true,
  "description": "Local hi-res FLAC player with Google Cast support",
  "author": "@vicemora97 and Flac Cast contributors",
  "main": "dist/main/main.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "npm run build && electron .",
    "start": "electron .",
    "check": "tsc --noEmit",
    "generate:icon": "node scripts/generate-icon.mjs",
    "package:win": "npm run build && npm run generate:icon && node scripts/package-windows.mjs",
    "make:win": "npm run build && npm run generate:icon && node scripts/make-windows.mjs"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@types/node": "^24.0.0",
    "electron": "^37.4.0",
    "electron-winstaller": "5.4.4",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "bonjour-service": "^1.4.4",
    "castv2-client": "^1.2.0",
    "electron-squirrel-startup": "^1.0.1",
    "ffmpeg-static": "^5.3.0",
    "music-metadata": "^11.8.0"
  },
  "overrides": {
    "@electron/packager": "20.3.0",
    "protobufjs": "7.6.5"
  }
}
